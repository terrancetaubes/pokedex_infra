{
  "experimentalFeaturesEnabled": {
    "extensibility": true
  },
  "extensions": {
    "microsoftGraphV1": "br:mcr.microsoft.com/bicep/extensions/microsoftgraph/v1.0:0.1.8-preview"
  },
  "analyzers": {
    "core": {
      "enabled": true,
      "rules": {
        "no-hardcoded-env-urls": { "level": "warning" },
        "prefer-unquoted-property-names": { "level": "warning" },
        "use-resource-symbol-reference": { "level": "warning" },
        "secure-parameter-default": { "level": "error" },
        "no-unused-params": { "level": "warning" }
      }
    }
  }
}
